<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Hlášení pádů (Crashlytics) jen z Release buildu: hodnota je build setting
	     PLUME_CRASHLYTICS_COLLECTION_ENABLED (Debug NO, Release YES v project.pbxproj).
	     Crashlytics bere i textové YES/NO. -->
	<key>FirebaseCrashlyticsCollectionEnabled</key>
	<string>$(PLUME_CRASHLYTICS_COLLECTION_ENABLED)</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>NSUserActivityTypes</key>
	<array>
		<string>INSendMessageIntent</string>
	</array>
	<key>PlumeAppGroup</key>
	<string>group.eu.tintera.plume$(TEAM_ID)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>eu.tintera.plume.share</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>eu.tintera.plume</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>eu.tintera.plume.telegram</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>tg</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
