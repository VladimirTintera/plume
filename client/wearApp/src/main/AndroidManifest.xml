<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- NetworkMonitor (core/connectivity) hlásí TDLib druh sítě. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Nahrávání hlasovek mikrofonem hodinek; o oprávnění se žádá až na obrazovce nahrávání. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Jednorázové poslání polohy z konverzace (SendLocationScreen). GPS není nutná:
         hodinky bez ní pošlou polohu ze sítě nebo z telefonu. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <!-- Vlastní notifikace z pushe (Android 13+ se na ně ptá za běhu, po přihlášení). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".WearApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- Samostatná aplikace: vlastní sezení TDLib, telefon k běhu nepotřebuje. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <!-- Hlášení pádů: placeholder z build typu (release true, jinak false), jako u telefonu. -->
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="${crashlyticsCollectionEnabled}" />

        <service
            android:name=".WearMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Akce z notifikace (Odpovědět, Přečteno). -->
        <receiver
            android:name=".WearNotificationReceiver"
            android:exported="false" />

        <!-- Dlaždice s počtem nepřečtených chatů (UnreadTileService). -->
        <service
            android:name=".UnreadTileService"
            android:exported="true"
            android:label="@string/tile_unread_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
        </service>

        <!-- Dlaždice s chaty ze začátku seznamu (RecentChatsTileService). -->
        <service
            android:name=".RecentChatsTileService"
            android:exported="true"
            android:label="@string/tile_chats_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
        </service>

        <!-- Komplikace na ciferník; obnovu si vyžádá UnreadCountPublisher, pravidelná není. -->
        <service
            android:name=".UnreadComplicationService"
            android:exported="true"
            android:icon="@drawable/ic_complication_unread"
            android:label="@string/complication_unread_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="0" />
        </service>

        <!-- Rychlá poznámka do Uložených zpráv: dlaždice, komplikace a aktivita s diktováním.
             Aktivita ve vlastní úloze a mimo nedávné: po uložení se vrací na ciferník / dlaždici,
             ne do seznamu chatů. -->
        <service
            android:name=".QuickNoteTileService"
            android:exported="true"
            android:label="@string/tile_note_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
        </service>
        <service
            android:name=".QuickNoteComplicationService"
            android:exported="true"
            android:icon="@drawable/ic_quick_note"
            android:label="@string/complication_note_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="MONOCHROMATIC_IMAGE,SHORT_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="0" />
        </service>
        <!-- Exportovaná: spouští ji dlaždice, kterou kreslí systém v jiném procesu. Nic citlivého
             neumí — otevře diktování a uloží jen to, co uživatel sám nadiktuje. -->
        <activity
            android:name=".QuickNoteActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity="eu.tintera.plume.quicknote" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
