<?xml version="1.0" encoding="utf-8"?>
<!-- Direct Share: chaty v systémové nabídce „Sdílet". Zkratky konverzací publikuje aplikace sama
     (conversationShortcut) s kategorií níž; bez tohohle párování je systém ke sdílení nenabídne.
     Kategorie musí sedět se SHARE_CATEGORY v kódu. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <share-target android:targetClass="eu.tintera.plume.MainActivity">
        <data android:mimeType="*/*" />
        <category android:name="eu.tintera.plume.category.SHARE_TARGET" />
    </share-target>
</shortcuts>
