<?xml version="1.0" encoding="utf-8"?>
<!-- Soubory, které smí otevřít jiná aplikace: stažené soubory TDLib, čerstvě odeslané přílohy,
     u kterých TDLib drží ještě naši kopii v cache, a kopie ke sdílení. Provider sám nic nevydává — oprávnění se
     uděluje jen na konkrétní URI. -->
<paths>
    <files-path
        name="tdlib_files"
        path="tdlib-files/" />
    <cache-path
        name="outgoing"
        path="outgoing/" />
    <!-- Kopie pod čitelným jménem pro sdílení z prohlížeče (MediaSharer). -->
    <cache-path
        name="shared"
        path="shared/" />
    <!-- Kopie pod čitelným jménem ve schránce (MediaSharer.copy). -->
    <cache-path
        name="clipboard"
        path="clipboard/" />
    <!-- Fotky a videa z fotoaparátu (Vyfotit / Natočit video ve sponce). Zapisuje do nich jiná
         aplikace, proto přes provider; po přípravě přílohy se mažou (AttachmentPicker). -->
    <cache-path
        name="camera"
        path="camera/" />
</paths>
