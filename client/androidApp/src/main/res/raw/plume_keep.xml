<?xml version="1.0" encoding="utf-8"?>
<!-- Prostředky, na které nesahá kód, a zmenšení prostředků v release by je proto vyhodilo.
     tools:keep platí jen v souboru v res/raw (jako firebase_common_keep.xml): na kořeni
     values/wear.xml ho shrinker AGP 9 ignoroval a pole schopností z APK zmizelo.

     android_wear_capabilities: schopnost plume_phone, podle které hodinky najdou telefon
     (přihlášení telefonem, přepis hlasovky). Čtou ji Play služby, ne kód. -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@array/android_wear_capabilities" />
