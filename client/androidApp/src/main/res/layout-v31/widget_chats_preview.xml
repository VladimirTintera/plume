<?xml version="1.0" encoding="utf-8"?>
<!-- Náhled widgetu s chaty v nabídce widgetů launcheru (Android 12+, `previewLayout`): kostra
     se záhlavím a řádky bez skutečných chatů — náhled vidí kdokoli u telefonu a nic z účtu do něj
     nepatří. Jen prvky povolené v RemoteViews (holý View mezi nimi není). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_background"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="8dp"
        android:text="@string/widget_chats_label"
        android:textColor="@color/widget_preview_title"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="6dp">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_preview_avatar" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="90dp"
                android:layout_height="12dp"
                android:background="@drawable/widget_preview_line" />

            <FrameLayout
                android:layout_width="130dp"
                android:layout_height="10dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/widget_preview_line" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="6dp">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_preview_avatar" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="90dp"
                android:layout_height="12dp"
                android:background="@drawable/widget_preview_line" />

            <FrameLayout
                android:layout_width="100dp"
                android:layout_height="10dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/widget_preview_line" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="6dp">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_preview_avatar" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="12dp"
                android:background="@drawable/widget_preview_line" />

            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="10dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/widget_preview_line" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
