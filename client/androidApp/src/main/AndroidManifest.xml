<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Biometrie pro odemykání aplikace. Běžné oprávnění udělované při instalaci. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Od Androidu 13 běhové oprávnění; bez něj `notify` tiše nic neudělá. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Nahrávání hlasovek a video zpráv; ptá se až při prvním podržení tlačítka. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Synchronizace adresáře s Telegramem — jen po zapnutí v Nastavení → Soukromí. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Video zprávy (kolečka); ptá se až při prvním nahrávání. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Hlasovka u ucha: přepnutí zvuku do sluchátka (MODIFY_AUDIO_SETTINGS) a zhasnutí displeje,
         dokud je senzor přiblížení zakrytý (WAKE_LOCK). Obojí se uděluje při instalaci. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Hudba na pozadí: služba v popředí s MediaSession (MusicPlaybackService). Typ
         mediaPlayback se od Androidu 14 musí vyjmenovat zvlášť a Play ho chce vysvětlit
         v deklaraci služeb v popředí. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Hovory: služba v popředí po dobu hovoru (typ phoneCall chce MANAGE_OWN_CALLS, mikrofon
         na pozadí typ microphone, kamera videohovoru typ camera) a celoobrazovková výzva
         příchozího hovoru. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Ukazovátko protistrany přes jiné aplikace při sdílení obrazovky (AndroidCallPointerDisplay). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Vibrace při vyzvánění hovoru (CallRinger). Haptika aplikace jde přes view a oprávnění
         nepotřebuje — tohle je jen pro zvonění. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Stahování modelu Gemma (gigabajty) jako úloha WorkManageru se službou v popředí
         (ModelDownloadWorker). Typ dataSync Play taky chce vysvětlit v deklaraci služeb v popředí. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Sdílení živé polohy: služba v popředí typu location (LiveLocationService). Spouští se jen
         z popředí, takže oprávnění k poloze NA POZADÍ potřeba není. Play typ chce vysvětlit
         v deklaraci služeb v popředí, jako mediaPlayback a dataSync. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Uložení fotky a videa do galerie. Od Androidu 10 zapisuje MediaStore bez oprávnění. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Přibližná poloha pro hledání míst v okolí (anketa, sponka → Poloha); ptá se až tehdy.
         Přesnou chce jen tlačítko bota „pošli polohu" — taxi ani kurýr s kilometrovou přesností
         nic nenadělají. I tam smí uživatel povolit jen přibližnou a pošle se ta. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Oprávnění k poloze by jinak udělalo z polohy povinný hardware a aplikace by zmizela
         z Play pro zařízení bez něj; bez polohy se jen nenajdou místa v okolí. -->
    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />
    <!-- Přesná poloha by jinak vyžadovala GPS. -->
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.network"
        android:required="false" />

    <!-- Oprávnění ke kameře by jinak udělalo z kamery povinný hardware a aplikace by zmizela
         z Play pro zařízení bez ní; bez kamery se jen nenabízí kolečko. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <!-- Senzor přiblížení je jen pro hlasovku u ucha a tablety ho nemají; `required=false`, ať
         aplikace kvůli němu nezmizí z Play pro zařízení, kde chybí. -->
    <uses-feature
        android:name="android.hardware.sensor.proximity"
        android:required="false" />

    <!-- Predictive back. Při targetSdk 35+ ho systém zapíná sám a tenhle příznak ignoruje;
         je tu jako výslovné prohlášení a pojistka, kdyby targetSdk někdy klesl. Samotnou
         animaci uvnitř aplikace dělá NavDisplay přes androidx.navigationevent. -->
    <application
        android:name=".MainApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Plume">

        <!-- GPU backend LiteRT-LM (Gemma v zařízení). Systémové knihovny, které aplikace smí
             načíst, jen když si o ně řekne; `required=false`, protože kde nejsou, jede model na CPU. -->
        <uses-native-library android:name="libvndksupport.so" android:required="false" />
        <uses-native-library android:name="libOpenCL.so" android:required="false" />

        <!-- Obraz v obraze u videa (PictureInPicture.android.kt) posílá do okénka celou
             aktivitu. Přechod mění velikost okna, takže `smallestScreenSize` musí být mezi
             `configChanges` — jinak by se aktivita vytvořila znovu a přehrávač s ní zanikl. -->
        <!-- Konverzace v bublině z notifikace (Android 11+). Vlastní aktivita: MainActivity je
             singleTask a otevřela by celou aplikaci. Bublina chce vložitelnou aktivitu
             (allowEmbedded, resizeableActivity) s dokumentem pro každý chat. Míří se na ni
             AKCÍ a balíčkem (NotificationIntents.bubble), :client:shared třídu nezná. -->
        <activity
            android:name=".BubbleActivity"
            android:exported="false"
            android:allowEmbedded="true"
            android:resizeableActivity="true"
            android:documentLaunchMode="always"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density|fontScale"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Plume">
            <intent-filter>
                <action android:name="eu.tintera.plume.action.BUBBLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="plume-bubble" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density|fontScale"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Plume">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Sdílení z jiných aplikací: text, odkaz, jeden i víc souborů. Soubory se hned
                 kopírují do cache (ShareIntake), oprávnění k jejich URI je jen dočasné. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <!-- Odkazy na Telegram z jiných aplikací a z fotoaparátu (naskenovaný „Můj QR kód"):
                 otevře je shell přes LinkOpenRequests. Schéma tg:// systém doručí rovnou (s oficiálním
                 klientem nabídne výběr). Doménu t.me Plume ověřit nemůže (assetlinks.json na ní vydává
                 Telegram), proto bez autoVerify: od Androidu 12 ji systém pošle sem, až ji uživatel
                 povolí v „Otevírat ve výchozím nastavení" (řádek v Nastavení → Obecné → Chaty). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tg" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="t.me" />
                <data android:host="*.t.me" />
                <data android:host="telegram.me" />
                <data android:host="telegram.dog" />
            </intent-filter>

            <!-- Direct Share: chaty přímo v nabídce „Sdílet" (res/xml/shortcuts.xml). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Hlášení pádů. Hodnota je placeholder z build typu (release true, jinak false) —
             za běhu se přepínat nedá, Crashlytics si příznak čte při inicializaci procesu.
             Bez google-services.json se Firebase neinicializuje a příznak nikdo nečte. -->
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="${crashlyticsCollectionEnabled}" />

        <!-- Text z fotky (core/ocr) a odstranění pozadí samolepky (core/stickers): Play služby
             stáhnou modely hned po instalaci, ne až při prvním ťuknutí — jinak by první pokus
             skončil chybou „model se stahuje". -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr,subject_segment" />

        <!-- Fotky ze zpráv v notifikacích. Notifikaci kreslí System UI v jiném procesu a do
             souborů aplikace nesmí; oprávnění ke čtení mu přidělí NotificationManager. Autorita
             musí sedět s IMAGE_AUTHORITY_SUFFIX v NotificationPresenter. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.notificationimages"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/notification_images" />
        </provider>

        <!-- Stažené soubory z chatu, které otevírá jiná aplikace (FileOpener). Oprávnění se
             uděluje jen na konkrétní URI a jen na to jedno otevření. -->
        <provider
            android:name=".DocumentFileProvider"
            android:authorities="${applicationId}.documents"
            android:exported="false"
            android:grantUriPermissions="true">
            <!-- Cesty musí být i tady, ne jen v konstruktoru: `getUriForFile` si strategii
                 skládá z meta-dat, takže bez nich spadne na „Missing FILE_PROVIDER_PATHS". -->
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/documents" />
        </provider>

        <!-- Akce z notifikace (odpověď, přečtení, ztlumení). Neexportovaný: broadcast posílá PendingIntent naší aplikace,
             nikdo cizí ho vyvolat nemá. Míří se na něj akcí a balíčkem (NotificationIntents.reply),
             protože :client:shared tuhle třídu nezná. -->
        <!-- Widget s chaty na ploše; widget i přijímač jsou v :client:shared (core/widget). -->
        <receiver
            android:name="eu.tintera.plume.core.widget.ChatsWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_chats_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/chats_widget_info" />
        </receiver>

        <!-- Přihlášení hodinek potvrzené z telefonu (core/wear/WatchLogin): hodinky pošlou odkaz
             z QR kódu přes Wearable Data Layer, telefon se zeptá notifikací. Exportovaná kvůli
             Play službám; zprávy doručí jen od aplikace se stejným id a podpisem. -->
        <service
            android:name=".WatchLoginService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:path="/plume/watch-login"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <receiver
            android:name=".WatchLoginReceiver"
            android:exported="false" />

        <receiver
            android:name=".NotificationActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="eu.tintera.plume.action.NOTIFICATION_REPLY" />
                <action android:name="eu.tintera.plume.action.NOTIFICATION_MARK_READ" />
                <action android:name="eu.tintera.plume.action.NOTIFICATION_MUTE" />
                <action android:name="eu.tintera.plume.action.NOTIFICATION_DECLINE_CALL" />
                <action android:name="eu.tintera.plume.action.NOTIFICATION_DISMISS" />
            </intent-filter>
        </receiver>

        <!-- Hudba na pozadí (Media3). Exportovaná, protože se k relaci připojují systémové
             ovladače — notifikace, zamykací obrazovka, sluchátka, hodinky. Třída je v :client:shared. -->
        <service
            android:name="eu.tintera.plume.core.audio.MusicPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Sdílení živé polohy (LiveLocationService v :client:shared). -->
        <service
            android:name="eu.tintera.plume.core.calls.CallService"
            android:exported="false"
            android:foregroundServiceType="phoneCall|microphone|camera|mediaProjection" />
        <!-- Videochat ve skupině na pozadí (VideoChatService v :client:shared); mikrofon jen s mluvením. -->
        <service
            android:name="eu.tintera.plume.features.videochat.VideoChatService"
            android:exported="false"
            android:foregroundServiceType="phoneCall|microphone" />
        <service
            android:name="eu.tintera.plume.core.location.LiveLocationService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Služba v popředí, kterou WorkManager spouští pro dlouhé úlohy. Od Androidu 14 musí
             mít typ v manifestu; jediná taková úloha je stahování modelu (dataSync). -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- Bez google-services.json se služba nikdy nespustí, protože Firebase se
             neinicializuje; deklarace tedy nevadí ani v buildu bez pushe. -->
        <service
            android:name=".PlumeMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
