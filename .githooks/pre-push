#!/bin/sh
#
# Poznámka k vydání musí být ve větvi dřív, než z ní vznikne PR.
#
# Hlídá to i workflow „Release notes", jenže to se ozve až po pushnutí a otevření PR —
# tedy ve chvíli, kdy se k tomu člověk musí vracet. Tenhle hook říká totéž o krok dřív
# a **týmž skriptem** (`.github/scripts/release_notes.py`), aby se obě kontroly nemohly
# rozejít.
#
# Zapíná se jednou na klon:   git config core.hooksPath "$(git rev-parse --show-toplevel)/.githooks"
# Obejít jednorázově:         git push --no-verify
#
# Cesta musí být ABSOLUTNÍ. Relativní se počítá od pracovního stromu, do kterého se pushuje —
# a worktree (`.claude/worktrees/…`) stojí na vlastní větvi, kde `.githooks` být nemusí. Hook
# pak tiše neběží, protože git na chybějící cestu nenadává.
#
# Nekontroluje se:
#  - tagy — release se vydává pushnutím tagu `android-<versionName>-<versionCode>`
#    a poznámky v něm už dávno jsou; blokovat ho by znamenalo rozbít vydávání,
#  - `main` — tam se nic nedostane jinak než sloučením PR, který kontrolou prošel,
#  - mazání větve.
set -u

# Bez known `origin/main` není co s čím porovnat (čerstvý klon bez fetche, jiný remote).
git rev-parse --verify --quiet refs/remotes/origin/main >/dev/null || exit 0

zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')
hook_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
status=0

# Jeden dočasný adresář na celý push, uklidí se i po `continue` a přerušení.
tmp_root=$(mktemp -d) || exit 1
trap 'rm -rf "$tmp_root"' EXIT
trap 'exit 1' INT TERM HUP

script_path=".github/scripts/release_notes.py"
n=0

while read -r local_ref local_sha remote_ref remote_sha; do
    [ -n "${local_ref:-}" ] || continue
    [ "$local_sha" = "$zero" ] && continue

    case "$local_ref" in refs/tags/*) continue ;; esac
    case "$remote_ref" in refs/heads/main) continue ;; esac

    base=$(git merge-base refs/remotes/origin/main "$local_sha" 2>/dev/null) || continue

    n=$((n + 1))
    tmp="$tmp_root/$n"
    mkdir -p "$tmp/notes" || exit 1

    # Skript se bere Z PUSHOVANÉHO COMMITU, stejně jako ho vezme CI. Hook leží v hlavním
    # stromu (absolutní `core.hooksPath`) a ten může stát na staré větvi: PR, který pravidla
    # rozšiřuje (nová hodnota `units:`), by jinak lokálně neprošel, ač CI ho pustí.
    # Teprve když pushovaný strom skript nemá (větev starší než skript), vezme se ten vedle
    # hooku; když není ani ten, kontrola formátu se přeskočí a zbyde na CI.
    script=""
    if git cat-file -e "$local_sha:$script_path" 2>/dev/null \
        && git show "$local_sha:$script_path" > "$tmp/release_notes.py"; then
        script="$tmp/release_notes.py"
    elif [ -f "$hook_dir/../$script_path" ]; then
        script="$hook_dir/../$script_path"
    fi
    # Na Windows (Git Bash) je cesta `/c/…`, a Python pro Windows jí rozumí jen díky převodu
    # argumentů v MSYS. S `MSYS_NO_PATHCONV=1` (potřebuje ho adb) převod neběží, Python
    # dostal `/c/Develop/…`, četl to jako `C:\c\Develop\…` a hook spadl na chybějícím
    # souboru. `cygpath -m` udělá cestu `C:/…`, které rozumí obě strany (i u `/tmp/…`).
    if [ -n "$script" ] && command -v cygpath >/dev/null 2>&1; then
        script=$(cygpath -m "$script")
    fi

    added=$(git diff --diff-filter=A --name-only "$base" "$local_sha" -- 'release-notes/*.md')
    # Jen komunitní překlady (Weblate) poznámku nepotřebují — stejné pravidlo jako v CI.
    if [ -z "$added" ] && [ -n "$script" ] && command -v python3 >/dev/null 2>&1 \
        && python3 "$script" exempt $(git diff --name-only "$base" "$local_sha") >/dev/null; then
        continue
    fi
    if [ -z "$added" ]; then
        branch=${local_ref#refs/heads/}
        echo "chyba: větev '$branch' nepřidává poznámku do release-notes/." >&2
        echo "       Přidej release-notes/$(echo "$branch" | tr '/' '-').md s řádky type:/cs:/en:" >&2
        echo "       (nebo jen 'type: internal', když uživatel nic nepozná)." >&2
        status=1
        continue
    fi

    # Formát se čte Z PUSHOVANÉHO COMMITU, ne z pracovního stromu: pushnout jde i starší
    # commit, než na jaký se člověk zrovna dívá, a hlídá se to, co uvidí CI.
    command -v python3 >/dev/null 2>&1 || {
        echo "poznámka: python3 tu není, formát poznámky ověří až CI." >&2
        continue
    }
    if [ -z "$script" ]; then
        echo "poznámka: release_notes.py tu není, formát poznámky ověří až CI." >&2
        continue
    fi

    changed=$(git diff --diff-filter=AM --name-only "$base" "$local_sha" -- 'release-notes/*.md')
    for file in $changed; do
        git show "$local_sha:$file" > "$tmp/notes/$(basename "$file")" || status=1
    done

    # Kontrola běží AŽ V TOM adresáři, aby se v hlášce objevilo jméno poznámky,
    # a ne cesta do /var/folders, ve které ji nikdo nehledá.
    (cd "$tmp/notes" && python3 "$script" check ./*.md) || status=1
done

exit $status
